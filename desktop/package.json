{
  "name": "sos-flex-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n FLASK,VITE,ELECTRON -c green,cyan,magenta \"npm:dev:flask\" \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:flask": "cross-env PORT=5000 FLASK_DEBUG=0 powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\\\dev-flask.ps1",
    "dev:vite": "vite",
    "dev:electron": "npm run build:electron && wait-on tcp:5173 && electron .",
    "build": "npm run build:vite && npm run build:electron",
    "build:vite": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json && node electron/build.cjs",
    "build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\\\build-backend.ps1",
    "package:win": "node scripts\\\\package-win.cjs",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^41.3.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.sos.flex.scheduler",
    "productName": "SOS FLEX Scheduler",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "extraResources": [
      {
        "from": "../templates",
        "to": "app/templates"
      },
      {
        "from": "../public",
        "to": "app/public"
      },
      {
        "from": "backend-dist/flex-backend.exe",
        "to": "backend/flex-backend.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

