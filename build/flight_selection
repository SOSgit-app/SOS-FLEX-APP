<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Air Force Flex A Scheduler - Flight Selection</title>
    <style>
        body {
            background-color: #1a2f5a;
            color: white;
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .container {
            background-color: rgba(255, 255, 255, 0.1);
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.3);
            width: 100%;
            max-width: 800px;
        }
        h1 {
            text-align: center;
            color: #ffffff;
            margin-bottom: 30px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        .form-group {
            margin-bottom: 20px;
        }
        label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
        }
        input[type="text"], input[type="number"] {
            width: 100%;
            padding: 10px;
            border: 2px solid #ffffff;
            background-color: rgba(255, 255, 255, 0.1);
            color: white;
            border-radius: 4px;
            font-size: 16px;
            box-sizing: border-box;
        }
        .flight-section {
            margin-bottom: 25px;
            padding: 15px;
            border-radius: 6px;
            background-color: rgba(255, 255, 255, 0.05);
        }
        .flight-header {
            margin-bottom: 15px;
        }
        .flight-title {
            font-size: 1.2em;
            font-weight: bold;
            color: #fff;
        }
        .class-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
            gap: 10px;
            padding: 10px 0;
        }
        .class-button {
            padding: 8px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            text-align: center;
            transition: all 0.2s ease-in-out;
        }
        .class-button.selected {
            transform: scale(1.05);
            border: 2px solid white;
        }
        .knights .class-button {
            background-color: #FFFFFF;
            color: #FF0000;
        }
        .knights .class-button:hover {
            background-color: #f5f5f5;
        }
        .knights .class-button.selected {
            background-color: #f5f5f5;
            box-shadow: 0 0 15px rgba(255, 0, 0, 0.6);
            border: 2px solid #FF0000;
            font-weight: bold;
        }
        .bulls .class-button {
            background-color: #4B0F0F;
            color: #FFA500;
        }
        .bulls .class-button:hover {
            background-color: #3a0c0c;
        }
        .bulls .class-button.selected {
            background-color: #3a0c0c;
            box-shadow: 0 0 15px rgba(255, 165, 0, 0.6);
            border: 2px solid #FFA500;
            font-weight: bold;
        }
        .centurions .class-button {
            background-color: #228B22;
            color: #FFFF00;
        }
        .centurions .class-button:hover {
            background-color: #1b6e1b;
        }
        .centurions .class-button.selected {
            background-color: #1b6e1b;
            box-shadow: 0 0 15px rgba(255, 255, 0, 0.6);
            border: 2px solid #FFFF00;
            font-weight: bold;
        }
        .tigers .class-button {
            background-color: #E65100;
            color: #000000;
        }
        .tigers .class-button:hover {
            background-color: #b84100;
        }
        .tigers .class-button.selected {
            background-color: #b84100;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.6);
            border: 2px solid #000000;
            font-weight: bold;
        }
        button[type="submit"] {
            width: 100%;
            padding: 12px;
            background-color: #af9b62;
            color: #1a2f5a;
            border: none;
            border-radius: 4px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 20px;
        }
        button[type="submit"]:hover {
            background-color: #c5b178;
        }
        .flight-button {
            padding: 10px 20px;
            margin: 5px;
            border: none;
            border-radius: 4px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        /* Knights Squadron */
        .flight-button[value^="A"] {
            background-color: #FFFFFF;
            color: #FF0000;
        }
        
        .flight-button[value^="A"]:hover {
            background-color: #f5f5f5;  /* Slightly darker white for hover */
        }
        
        /* Bulls Squadron */
        .flight-button[value^="B"] {
            background-color: #4B0F0F;
            color: #FFA500;
        }
        
        .flight-button[value^="B"]:hover {
            background-color: #3a0c0c;  /* Slightly darker maroon for hover */
        }
        
        /* Centurions Squadron */
        .flight-button[value^="C"] {
            background-color: #228B22;
            color: #FFFF00;
        }
        
        .flight-button[value^="C"]:hover {
            background-color: #1b6e1b;  /* Slightly darker green for hover */
        }
        
        /* Tigers Squadron */
        .flight-button[value^="F"] {
            background-color: #E65100;
            color: #000000;
        }
        
        .flight-button[value^="F"]:hover {
            background-color: #b84100;  /* Slightly darker orange for hover */
        }
        
        /* Selected state for all buttons */
        .flight-button.selected {
            transform: scale(0.95);
            box-shadow: inset 0 0 10px rgba(0,0,0,0.2);
        }
    </style>
</head>
