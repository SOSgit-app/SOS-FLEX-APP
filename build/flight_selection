    <script>
        // Function to update checkbox state and visual feedback
        function updateSelection(button, checkbox) {
            button.classList.toggle('selected');
            checkbox.checked = !checkbox.checked;
            
            // Update selected count
            const selectedClasses = Array.from(document.querySelectorAll('input[name="classes"]:checked'));
            document.getElementById('count').textContent = selectedClasses.length;
        }

        // Add click handlers to all class buttons
        document.querySelectorAll('.class-button').forEach(button => {
            const checkbox = document.getElementById(button.getAttribute('for'));
            
            // Handle click on the button/label
            button.addEventListener('click', function(e) {
                e.preventDefault(); // Prevent default label behavior
                updateSelection(this, checkbox);
            });
        });

        // Add form submission handler
        document.querySelector('form').addEventListener('submit', function(e) {
            const selectedClasses = Array.from(document.querySelectorAll('input[name="classes"]:checked'));
            
            // Debug logging
            console.log('Number of selected classes:', selectedClasses.length);
            console.log('Selected classes:', selectedClasses.map(cb => cb.value));
            
            // Validate selection
            if (selectedClasses.length < 2) {
                e.preventDefault();
                alert('Please select at least two classes to create a schedule.');
            }
        });

        document.querySelector('form').onsubmit = function() {
            // Get referee data
            const refereeList = document.getElementById('referee-list').value;
            
            // Create hidden input for referee data
            const refereeInput = document.createElement('input');
            refereeInput.type = 'hidden';
            refereeInput.name = 'referee_list';
            refereeInput.value = refereeList;
            this.appendChild(refereeInput);
            
            return true;
        };
    </script>
